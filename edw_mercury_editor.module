<?php

/**
 * @file
 * Contains EDW Mercury Editor module.
 */

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityChangedInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\TranslatableInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\edw_mercury_editor\Render\ComponentAttributesAudit;

/**
 * Implements hook_form_alter().
 *
 * Adds optimistic-locking validation to Mercury Editor entity forms so that a
 * user is warned, instead of silently overwriting, when the entity was saved by
 * someone else after the current editing session started.
 *
 * Also restores the "Published" checkbox, which Gin otherwise removes from the
 * editor tray.
 */
function edw_mercury_editor_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof EntityFormInterface
    && $form_object->getOperation() === 'mercury_editor') {
    $form['#validate'][] = 'edw_mercury_editor_concurrent_edit_validate';
    // Must run in #after_build: Gin is a theme, so its hook_form_alter() runs
    // after every module's and has not yet grouped the field at this point.
    $form['#after_build'][] = 'edw_mercury_editor_restore_status_field';
  }
}

/**
 * After-build: keeps the "Published" checkbox inside the Mercury Editor tray.
 *
 * Gin renders the published state in its sticky form-actions bar rather than in
 * the form body. It gets there in two steps:
 *   1. GinContentFormHelper::formAlter() sets $form['status']['#group'] to
 *      'status', which relocates the checkbox into the container Gin creates at
 *      $form['gin_sticky_actions']['status'].
 *   2. gin_form_after_build() then stashes that container in
 *      _gin_form_actions() and unsets it from the form, so
 *      gin_preprocess_page() can print it as {{ gin_form_actions }} from Gin's
 *      own page template.
 *
 * Mercury Editor renders neither Gin's page template nor its form template, so
 * step 2 never happens and the checkbox is lost: core's preRenderGroup() still
 * marks the element '#printed' because the group exists, and the container that
 * was meant to render it is gone.
 *
 * Undoing the grouping brings the checkbox back. It is then moved next to the
 * state it changes, and together with NodeForm's read-only publishing info
 * ($form['meta']: "Published"/"Not published", "Last saved", "Author") put
 * in a collapsible "details", instead of sitting at its form display
 * position further up the tray.
 *
 * On a moderated bundle content_moderation hides the checkbox and the
 * moderation state widget takes its place, so that widget goes first in the
 * group. Core only moves it into the form's footer for the 'edit' and
 * 'default' operations, which leaves it loose at the bottom of the form here
 * otherwise.
 *
 * The state field - the moderation widget, or else the checkbox - is then
 * mirrored by a dropdown in the Mercury Editor toolbar, left of "Save"
 * (js/status-dropdown.js), which hides it in the tray. It stays in the form
 * so "Save" submits it, and without JS it is still usable here. The group is
 * therefore titled "Revision information", after what remains visible: Last
 * saved, Author and the revision fields. It replaces NodeForm's "Published"
 * heading, since the toolbar now shows the state.
 *
 * The revision fields ("Create new revision", "Revision log message") go in
 * the same group, after the publishing info: they describe the save, like the
 * publish state, and Gin already files them under the same Status section.
 * They get there differently, though. Gin sets
 * $form['revision_information']['#group'] = 'meta', so the container stays
 * at the top of the form and processGroup() has listed it, by reference, in
 * the form state's groups under 'meta', for the meta container to pull in at
 * render time. It is dropped from that list here, or meta would still
 * render it (the reference outlives the unset) and the moved copy, which
 * still carries '#group', would be skipped as already printed.
 *
 * Moved physically rather than via '#group': by #after_build every element
 * has been processed, and processGroup() has already filed it under its
 * original group, so only a physical move still takes effect. Their #parents
 * are already set, so submitted values keep their keys ('status' etc.). The
 * details wrapper itself is added unprocessed; the renderer fills in its
 * element defaults (theme wrapper, pre_render) when it is rendered.
 *
 * @see \Drupal\gin\GinContentFormHelper::formAlter()
 * @see gin_form_after_build()
 * @see \Drupal\Core\Render\Element\RenderElementBase::preRenderGroup()
 * @see \Drupal\node\NodeForm::form()
 */
function edw_mercury_editor_restore_status_field(array $form, FormStateInterface $form_state) {
  // Only act on Gin's grouping. Any other theme (e.g. Claro) leaves the field
  // alone, and this site has no field group named 'status'.
  if (($form['status']['#group'] ?? NULL) !== 'status') {
    return $form;
  }
  unset($form['status']['#group']);

  if (!isset($form['meta']['published'])) {
    return $form;
  }

  $published = $form['meta']['published'];
  // On a bundle outside any workflow the form display still places the
  // component, but ModerationStateWidget::form() returns [] for it, leaving an
  // element with no 'widget' child: nothing to move, and not "Moderation".
  $moderation_state = NULL;
  if (isset($form['moderation_state']['widget']) && ($form['moderation_state']['#access'] ?? TRUE) !== FALSE) {
    $moderation_state = ['#weight' => -2] + $form['moderation_state'];
    unset($moderation_state['#group'], $form['moderation_state']);
  }

  $publishing = [
    '#type' => 'details',
    '#title' => t('Revision information'),
    '#open' => FALSE,
    // Where 'published' was. FormBuilder::doBuildForm() has given NodeForm's
    // unweighted meta items fractional weights in array order (0, 0.001, ...),
    // so this keeps the group ahead of whatever else meta holds.
    '#weight' => $published['#weight'] ?? 0,
    '#attributes' => ['class' => ['edw-mercury-editor-publishing']],
    '#attached' => ['library' => ['edw_mercury_editor/status_dropdown']],
    'status' => ['#weight' => -1] + $form['status'],
  ];
  unset($form['status'], $form['meta']['published']);
  if ($moderation_state) {
    $publishing['moderation_state'] = $moderation_state;
  }
  foreach (['changed', 'author'] as $key) {
    if (isset($form['meta'][$key])) {
      $publishing[$key] = $form['meta'][$key];
      unset($form['meta'][$key]);
    }
  }

  if (($form['revision_information']['#group'] ?? NULL) === 'meta') {
    $publishing['revision_information'] = ['#weight' => 10] + $form['revision_information'];
    unset($publishing['revision_information']['#group'], $form['revision_information']);
    // Members are listed under integer keys, next to '#group_exists'.
    $groups = &$form_state->getGroups();
    foreach (array_filter(array_keys($groups['meta'] ?? []), 'is_int') as $key) {
      if (($groups['meta'][$key]['#array_parents'] ?? NULL) === ['revision_information']) {
        unset($groups['meta'][$key]);
      }
    }
  }

  $form['meta']['publishing'] = $publishing;
  return $form;
}

/**
 * Validation handler: detects a concurrent edit on a Mercury Editor save.
 *
 * Mercury Editor forces the entity "changed" timestamp to the current time on
 * every validate (MercuryEditorEntityFormTrait::validateForm), which bypasses
 * Drupal core's EntityChanged optimistic-lock constraint. To restore that
 * protection we compare the live database "changed" time against the base
 * timestamp this editing session started from — preserved in the private
 * tempstore by MercuryEditorParamConverter on write requests. If the database
 * is newer, another user (or another route) saved first and we block the save.
 *
 * @see \Drupal\edw_mercury_editor\Routing\MercuryEditorParamConverter
 */
function edw_mercury_editor_concurrent_edit_validate(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }

  $entity = $form_object->getEntity();
  // Only existing, change-tracked entities can have a conflict.
  if (!$entity instanceof EntityChangedInterface || !$entity->id()) {
    return;
  }

  // The tempstore holds the version this editing session is based on. On a save
  // POST the param converter keeps it even when the database is newer.
  $base = \Drupal::service('mercury_editor.tempstore_repository')->get($entity->uuid());
  if (!$base instanceof EntityChangedInterface) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage($entity->getEntityTypeId());
  $db_entity = $storage->loadUnchanged($entity->id());
  if (!$db_entity instanceof EntityChangedInterface) {
    return;
  }

  // Compare timestamps for the language being edited.
  $langcode = $entity->language()->getId();
  $base_changed = _edw_mercury_editor_changed_time($base, $langcode);
  $db_changed = _edw_mercury_editor_changed_time($db_entity, $langcode);

  if ($db_changed > $base_changed) {
    $form_state->setError(
      $form,
      t('The content has been updated by another user. Reload the page to get the latest version before saving.')
    );
  }
}

/**
 * Returns an entity's "changed" time for a langcode, falling back to default.
 *
 * @param \Drupal\Core\Entity\EntityChangedInterface $entity
 *   The change-tracked entity.
 * @param string $langcode
 *   The langcode of the translation being edited.
 *
 * @return int
 *   The changed timestamp.
 */
function _edw_mercury_editor_changed_time(EntityChangedInterface $entity, string $langcode): int {
  if ($entity instanceof TranslatableInterface && $entity->hasTranslation($langcode)) {
    $translation = $entity->getTranslation($langcode);
    if ($translation instanceof EntityChangedInterface) {
      return $translation->getChangedTime();
    }
  }
  return $entity->getChangedTime();
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function edw_mercury_editor_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with((string) $route_name, 'system.')) {
    // Do not display Mercury Editor chrome on 404 and 403 pages.
    $suggestions = array_filter($suggestions, function ($item) {
      return !str_starts_with($item, 'page__mercury');
    });
  }
}

/**
 * Implements hook_preprocess_HOOK() for the Mercury Editor page.
 *
 * This is the editor page itself - toolbar, dialogs and the tray around the
 * preview iframe - which renders under the admin theme. Styles for the document
 * *inside* the iframe are attached separately; see
 * edw_mercury_editor_page_attachments().
 *
 * Requires the default (frontend) theme to define an 'edit_screen' library
 * (e.g. `edwtfe/edit_screen`) with styles for the editor chrome. Not the
 * active theme: this page renders under the admin theme (gin), which knows
 * nothing about the site's editor styles, so `gin/edit_screen` would never
 * resolve and none of the chrome fixes - the admin toolbar offset included -
 * would load.
 *
 * Also adds a "View" button to the toolbar, next to "Save" and "Done", that
 * opens the entity's live canonical page in a new tab. This is deliberately
 * separate from "Done": that button navigates away and discards any tray
 * edits that were never persisted through the toolbar "Save", so it isn't
 * a safe way to just peek at the current published page mid-edit.
 */
function edw_mercury_editor_preprocess_page__mercury_editor(&$variables) {
  $variables['#attached']['library'][] = \Drupal::config('system.theme')->get('default') . '/edit_screen';

  // Add a "View" button to the toolbar, linking to the entity's live
  // canonical page. Only shown for entities that have actually been saved —
  // a new, not-yet-created entity has no page to view yet.
  $entity = \Drupal::service('mercury_editor.context')->getEntity();
  if ($entity instanceof ContentEntityInterface && !$entity->isNew()) {
    $variables['#attached']['library'][] = 'edw_mercury_editor/view_button';
    $variables['#attached']['drupalSettings']['edwMercuryEditor']['viewUrl'] = $entity
      ->toUrl('canonical', ['absolute' => TRUE])
      ->toString();
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Adds the theme's preview-iframe styles to the Mercury Editor preview route.
 *
 * The preview is a separate document from the editor page, rendered under the
 * frontend theme, so a preprocess hook on page__mercury_editor cannot reach it:
 * anything attached there lands on the chrome around the iframe instead. That
 * is what used to happen, which left rules targeting builder markup
 * (.js-lpb-component and friends) on a page that has none of it.
 *
 * Gated on the same service Mercury Editor uses to attach its own preview
 * assets. Requires the active theme to define a 'mercury_editor_preview'
 * library (e.g. `edwtfe/mercury_editor_preview`) with styles for the preview
 * document.
 *
 * @see mercury_editor_page_attachments()
 */
function edw_mercury_editor_page_attachments(array &$attachments) {
  if (\Drupal::service('mercury_editor.context')->isPreview()) {
    $attachments['#attached']['library'][] = \Drupal::theme()->getActiveTheme()->getName() . '/mercury_editor_preview';
  }
}

/**
 * Implements hook_element_info_alter().
 *
 * Appends a #post_render check to the Layout Paragraphs builder element (the
 * tray Mercury Editor renders inside its preview iframe) that flags any
 * component whose final markup is missing its "attributes".
 *
 * @see \Drupal\edw_mercury_editor\Render\ComponentAttributesAudit
 */
function edw_mercury_editor_element_info_alter(array &$info) {
  if (isset($info['layout_paragraphs_builder'])) {
    $info['layout_paragraphs_builder']['#post_render'][] = [
      ComponentAttributesAudit::class,
      'checkComponentAttributes',
    ];
  }
}
